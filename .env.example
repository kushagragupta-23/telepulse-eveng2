# TelePulse HUD — Backend & Optional Live API Configuration
# All secrets stay on the backend proxy and are NEVER bundled into the G2 WebView (.ehpk).
# The app works out-of-the-box with live public Hyperliquid + Polymarket APIs and an interactive Telegram stream.

# Optional: Connect a real Telegram Bot for live 2-way chat & channel bridge
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Optional: OpenRouter / OpenAI / Anthropic key for LLM reply drafts & Whisper STT
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: TON Center / Gram Wallet read-only watch address (defaults to TON Foundation testnet/demo address)
GRAM_WALLET_ADDRESS=UQBvI0aFLnw2QbZgjMPCLRdtRHxhUyinQudg6sdiohIwg5jL

# Standalone backend port (when running `npm run server` separately from Vite)
PORT=8787
